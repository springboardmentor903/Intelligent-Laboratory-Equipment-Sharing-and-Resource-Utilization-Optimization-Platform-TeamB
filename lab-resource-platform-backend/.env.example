# Backend Environment Configuration
# Copy this file to .env and enter your local values.
# Never commit the actual .env file.

# PostgreSQL
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_local_database_password

# JWT Authentication
# Generate a Base64-encoded 256-bit secret.
JWT_SECRET=replace_with_base64_encoded_jwt_secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Initial System Administrator (if enabled)
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=replace_with_secure_admin_password
