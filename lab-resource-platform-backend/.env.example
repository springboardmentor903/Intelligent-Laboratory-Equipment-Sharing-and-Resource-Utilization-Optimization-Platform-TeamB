# ==============================================================================
# Backend Environment Configuration (.env.example)
# Copy this file to '.env' and fill in your actual local configuration.
# Do NOT commit your real '.env' file with production credentials to Git.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Local port defaults to 5432 and database name to lab_resource_platform
DB_PASSWORD=your_postgres_password_here

# JWT Authentication Secret Key (Base64-encoded 256-bit key)
# Generate a fresh secret via: openssl rand -base64 32
JWT_SECRET=bXlzZWNyZXRrZXlteXNlY3JldGtleW15c2VjcmV0a2V5MTI=

# Google OAuth 2.0 Credentials (Optional - required only for Google OAuth2 login)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Initial System Administrator Account (Optional - used by AdminInitializer on startup)
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=AdminPassword123!
