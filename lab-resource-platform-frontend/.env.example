# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Optional: Google OAuth2 Authorization Initiation URL
# Set this once the Spring Boot backend mounts spring-boot-starter-oauth2-client
# (e.g. http://localhost:8080/oauth2/authorization/google)
# VITE_GOOGLE_AUTH_URL=http://localhost:8080/oauth2/authorization/google
